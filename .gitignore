# ============================================
# .gitignore for vibe-kanban-docker
# ============================================

# Editor and IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Local configuration (user-specific)
# The example is tracked, but actual settings are not
vibe-kanban-docker_settings.yaml

# Claude Code local settings (user-specific paths)
.claude/settings.local.json

# Temporary/development files
tmp/

# Local privacy audit working files (may contain PII findings)
# Note: docs/PRIVACY_AUDIT.md IS tracked (clean summary)
privacy-audit-*.md

# Temporary files
*.tmp
*.log

# Build artifacts (none expected, but just in case)
target/
node_modules/
