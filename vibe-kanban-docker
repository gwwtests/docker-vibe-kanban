#!/bin/bash
# ============================================
# vibe-kanban-docker
# ============================================
# Orchestration script for vibe-kanban Docker containers.
#
# Usage: vibe-kanban-docker [OPTIONS] <command> [args...]
#
# See: vibe-kanban-docker help
# ============================================

set -euo pipefail

# ============================================
# Configuration & Defaults
# ============================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${VIBE_KANBAN_CONFIG_DIR:-$HOME/.config/vibe-kanban-docker}"

DOCKER_IMAGE="${VIBE_KANBAN_DOCKER_IMAGE:-vibe-kanban-docker:latest}"
CONTAINER_PREFIX="${VIBE_KANBAN_DOCKER_CONTAINER_PREFIX:-vkb_}"
PROVIDERS_VOL="${VIBE_KANBAN_PROVIDERS_VOL:-vibe_kanban_providers}"

# Port allocation: start at 15173 to avoid conflicts with:
# - Local vibe-kanban dev (3000-3001)
# - Local vibe-kanban Docker (3000)
# - Common dev ports (8080, 5173, etc.)
DEFAULT_BASE_PORT="${VIBE_KANBAN_DOCKER_BASE_PORT:-15173}"

# Providers env directory inside container
PROVIDERS_ENV_DIR="/home/devuser/.config/providers/env"

# Target directory (default: current working directory)
target_dir="$PWD"

# ============================================
# Utility Functions
# ============================================
ensure_config_dirs() {
    mkdir -p "$CONFIG_DIR/containers"
    mkdir -p "$CONFIG_DIR/container_mappings"
    mkdir -p "$CONFIG_DIR/port_mappings"
}

# ============================================
# Directory Canonicalization (tmuxdir-style)
# ============================================
# NOTE: Code using this function should verify the mapping in
# ~/.config/vibe-kanban-docker/container_mappings/ to ensure the
# derived container name maps to the expected directory.
#
# If a collision is detected (different directory, same canonical name),
# fallback by appending/incrementing a counter suffix:
#   - First collision: append "-1" (e.g., vkb_myproject-1)
#   - Subsequent: increment counter (e.g., vkb_myproject-2, -3, ...)
#
# Mapping file format: ~/.config/vibe-kanban-docker/container_mappings/<container_name>
# Contains the absolute canonical path (via readlink -f) of the directory.
# ============================================
generate_container_name() {
    local raw="$1"
    raw="${raw%/}"                                          # Strip trailing slashes
    raw="${raw##*/}"                                        # Keep only final component
    raw=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')  # Lowercase
    raw=$(printf '%s' "$raw" | tr -c '[:alnum:]' '_')       # Non-alnum → _
    raw=$(printf '%s' "$raw" | sed -E 's/_+/_/g; s/^_+//; s/_+$//')  # Collapse underscores
    printf '%s%s\n' "$CONTAINER_PREFIX" "$raw"
}

resolve_container_name() {
    local dir="$1"
    local canonical_dir
    canonical_dir=$(readlink -f "$dir")

    local base_name
    base_name=$(generate_container_name "$canonical_dir")

    ensure_config_dirs

    local mapping_file="$CONFIG_DIR/container_mappings/$base_name"

    # Check if this name is already mapped
    if [[ -f "$mapping_file" ]]; then
        local mapped_dir
        mapped_dir=$(cat "$mapping_file")
        if [[ "$mapped_dir" == "$canonical_dir" ]]; then
            # Same directory, return existing name
            echo "$base_name"
            return
        else
            # Collision! Find next available suffix
            local counter=1
            while [[ -f "$CONFIG_DIR/container_mappings/${base_name}-${counter}" ]]; do
                local check_dir
                check_dir=$(cat "$CONFIG_DIR/container_mappings/${base_name}-${counter}")
                if [[ "$check_dir" == "$canonical_dir" ]]; then
                    echo "${base_name}-${counter}"
                    return
                fi
                ((counter++))
            done
            echo "${base_name}-${counter}"
            return
        fi
    fi

    echo "$base_name"
}

save_container_mapping() {
    local container_name="$1"
    local dir="$2"
    local canonical_dir
    canonical_dir=$(readlink -f "$dir")

    ensure_config_dirs
    echo "$canonical_dir" > "$CONFIG_DIR/container_mappings/$container_name"
}

# ============================================
# Container Detection
# ============================================
container_exists() {
    docker ps -a --format '{{.Names}}' | grep -qw "^$1$"
}

container_running() {
    docker ps --format '{{.Names}}' | grep -qw "^$1$"
}

# ============================================
# Port Allocation
# ============================================
port_in_use() {
    ss -tuln 2>/dev/null | grep -q ":$1 " || \
    netstat -tuln 2>/dev/null | grep -q ":$1 " || \
    return 1
}

port_allocated() {
    grep -rq "^$1$" "$CONFIG_DIR/port_mappings/" 2>/dev/null
}

allocate_port() {
    local container_name="$1"
    local mapping_file="$CONFIG_DIR/port_mappings/$container_name"

    ensure_config_dirs

    # If already allocated, reuse
    if [[ -f "$mapping_file" ]]; then
        cat "$mapping_file"
        return
    fi

    # Find next available port
    local port="$DEFAULT_BASE_PORT"
    while port_in_use "$port" || port_allocated "$port"; do
        ((port++))
    done

    # Save allocation
    echo "$port" > "$mapping_file"
    echo "$port"
}

release_port() {
    local container_name="$1"
    rm -f "$CONFIG_DIR/port_mappings/$container_name"
}

# ============================================
# Mount Argument Parsing
# ============================================
# Parses: [--rw] <path> [--rw] <path> ...
# Outputs docker -v arguments, one per line
parse_mounts() {
    local next_rw=false

    for arg in "$@"; do
        if [[ "$arg" == "--rw" ]]; then
            next_rw=true
            continue
        fi

        local abs_path
        abs_path=$(readlink -f "$arg")
        local mount_opt=":ro"
        [[ "$next_rw" == true ]] && mount_opt=""

        echo "-v"
        echo "${abs_path}:${abs_path}${mount_opt}"
        next_rw=false
    done
}

# ============================================
# Container Metadata
# ============================================
save_container_metadata() {
    local container_name="$1"
    local dir="$2"
    local port="$3"
    shift 3
    local mounts=("$@")

    local canonical_dir
    canonical_dir=$(readlink -f "$dir")

    ensure_config_dirs

    local meta_file="$CONFIG_DIR/containers/${container_name}.yaml"

    cat > "$meta_file" << EOF
container_name: $container_name
directory: $canonical_dir
created_at: $(date -Iseconds)
image: $DOCKER_IMAGE
port: $port
mounts:
EOF

    # Parse mounts array to extract path and mode
    local next_rw=false
    for arg in "${mounts[@]}"; do
        if [[ "$arg" == "--rw" ]]; then
            next_rw=true
            continue
        fi

        local mode="ro"
        [[ "$next_rw" == true ]] && mode="rw"

        local abs_path
        abs_path=$(readlink -f "$arg")
        echo "  - path: $abs_path" >> "$meta_file"
        echo "    mode: $mode" >> "$meta_file"
        next_rw=false
    done
}

# ============================================
# Help
# ============================================
show_help() {
    cat << 'EOF'
vibe-kanban-docker - Sandboxed AI development with vibe-kanban

Usage: vibe-kanban-docker [OPTIONS] <command> [args...]

Commands:
  build                 Build the Docker image
  build --no-cache      Build without cache
  run [paths...]        Start/attach container with optional mounts
  shell                 Open interactive shell in running container
  exec <cmd>            Execute command in running container
  stop                  Stop the container (keeps it)
  rm                    Remove the container
  status                Show container status
  status --all          Show all tracked containers
  logs                  Show container logs
  providers login       Run credential setup (claude login, gh auth, etc.)
  providers status      Show credentials volume contents
  providers reset       Clear all stored credentials
  providers env set     Set environment variable
  providers env import  Import from .env file
  providers env list    List stored variables
  providers env show    Show variable value
